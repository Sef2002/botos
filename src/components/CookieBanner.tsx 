// components/CookieBanner.tsx
import { useEffect, useState } from "react";
import Cookies from "js-cookie";

const CookieBanner = () => {
  const [showBanner, setShowBanner] = useState(false);

  useEffect(() => {
    const consent = Cookies.get("cookie_consent");
    if (!consent) {
      setShowBanner(true);
    }
  }, []);

  const handleConsent = (choice: "accepted" | "declined") => {
    Cookies.set("cookie_consent", choice, { expires: 365 });
    setShowBanner(false);
  };

  if (!showBanner) return null;

  return (
    <div className="fixed bottom-0 left-0 w-full bg-gray-900 text-white p-4 z-50 shadow-xl flex flex-col md:flex-row items-center justify-between gap-2">
      <p className="text-sm">
        Questo sito utilizza cookie per migliorare l’esperienza. Accetti i cookie per statistiche anonime?
      </p>
      <div className="flex gap-2">
        <button
          className="bg-green-600 hover:bg-green-700 px-4 py-2 rounded text-sm"
          onClick={() => handleConsent("accepted")}
        >
          Accetta
        </button>
        <button
          className="bg-red-600 hover:bg-red-700 px-4 py-2 rounded text-sm"
          onClick={() => handleConsent("declined")}
        >
          Rifiuta
        </button>
      </div>
    </div>
  );
};

export default CookieBanner;